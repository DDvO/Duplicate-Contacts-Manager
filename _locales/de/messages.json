  "abooktoolbar.label": {
    "message": "Dubletten suchen"
  },
  "abooktoolbar.tooltip": {
    "message": "Dubletten in Ihren Thunderbird-Adressbüchern suchen und entfernen"
  },
  "handleDuplicates.windowtitle": {
    "message": "Dubletten suchen und behandeln"
  },
  "handleDuplicates.introheader": {
    "message": "Was passiert hier?"
  },
  "handleDuplicates.introtext": {
    "message": "In den ausgewählten Adressbüchern wird nach ähnlichen, möglicherweise redudanten Einträgen gesucht."
  },
  "handleDuplicates.chooseSecondary": {
    "message": "Wenn du zwei verschiedene Adressbücher auswählst, werden Dubletten (nur) zwischen den beiden Adressbüchern behandelt, ansonsten innerhalb des selben Adressbuchs."
  },
  "handleDuplicates.introtext2": {
    "message": "Jedes Mal, wenn ein Paar von Kandidaten präsentiert wird, kannst du entscheiden, sie zu überspringen, sie zu bearbeiten und beide zu behalten, oder einen möglicherweise zu bearbeiten und den anderen zu löschen."
  },
  "handleDuplicates.differentiator": {
    "message": "Wenn du ausschließen möchtest, dass Einträge jedes Mal als mögliche Dubletten angezeigt werden, kannst du ihnen unterschiedliche AIM-Namen geben."
  },
  "handleDuplicates.removeWithoutAsking": {
    "message": "Lösche ohne Nachfrage alle Dubletten mit weniger Informationen, oder bei identischen Einträgen den zweiten."
  },
  "handleDuplicates.preserveFirst": {
    "message": "Wenn zwei verschiedene Adressbücher ausgewählt sind, keine Einträge automatisch aus dem ersten löschen."
  },
  "handleDuplicates.deferInteractive": {
    "message": "Sammle erst alle wahrscheinlichen Dubletten, die manuelle Behandlung erfordern, und präesentiere sie dann interaktiv."
  },
  "handleDuplicates.durationWarning": {
    "message": "Abhängig von der Anzahl der Einträge in Ihrem Adressbuch und der Leistung Ihres Rechners kann dieser Vorgang eine Zeitlang dauern."
  },
  "handleDuplicates.natTrunkPrefix": {
    "message": "Anfangsziffer der Ortsvorwahl, z.B. '0'"
  },
  "handleDuplicates.intCallPrefix": {
    "message": "Internationale Anfangsziffer, z.B. '00'"
  },
  "handleDuplicates.countryCallingCode": {
    "message": "Standard-Landesvorwahl, z.B. '+49'"
  },
  "handleDuplicates.consideredFields": {
    "message": "Zu berücksichtigende Felder"
  },
  "handleDuplicates.ignoredFields": {
    "message": "Zu ignorierende Felder"
  },
  "handleDuplicates.introtext3": {
    "message": "Du kannst den Prozess unterbrechen, indem du 'Stop' drückst. Wenn du ein Paar nicht behandeln willst, klicke 'Überspringen'."
  },
  "handleDuplicates.introtext4": {
    "message": "Wenn du Änderungen speichern und beide Einträge behalten willst, drücke 'Beide behalten'; wenn du einen Eintrag löschen willst, drücke 'Einen löschen'."
  },
